generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model auth_attempts {
  key        String   @id
  count      Int
  expires_at DateTime @db.Timestamptz(6)

  @@index([expires_at], map: "auth_attempts_expiry")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model chat_messages {
  id         Int       @id @default(autoincrement())
  user_id    Int
  role       String
  content    String
  intent     String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "chat_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model events {
  id            Int             @id @default(autoincrement())
  title         String
  description   String
  category      String
  starts_at     DateTime        @db.Timestamptz(6)
  location      String
  capacity      Int
  price_cents   Int             @default(0)
  theme         String          @default("forest")
  published     Boolean         @default(true)
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  registrations registrations[]
}

model knowledge {
  id         Int       @id @default(autoincrement())
  title      String
  keywords   String
  answer     String
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

model notices {
  id         Int       @id @default(autoincrement())
  title      String
  body       String
  category   String    @default("Comunidade")
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

model notifications {
  id         Int       @id @default(autoincrement())
  user_id    Int
  title      String
  body       String
  read       Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "notifications_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id              Int           @id @default(autoincrement())
  registration_id Int           @unique
  amount_cents    Int
  status          String
  simulated       Boolean       @default(true)
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  registrations   registrations @relation(fields: [registration_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model registrations {
  id           Int       @id @default(autoincrement())
  user_id      Int
  event_id     Int
  status       String
  amount_cents Int
  ticket       String    @unique
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  payments     payments?
  events       events    @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, event_id])
}

model sessions {
  token      String   @id
  user_id    Int?
  expires_at DateTime @db.Timestamptz(6)
  users      users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "sessions_expiry")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model support_requests {
  id         Int       @id @default(autoincrement())
  user_id    Int
  message    String
  status     String    @default("open")
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id               Int                @id @default(autoincrement())
  name             String
  email            String             @unique
  password_hash    String
  role             String             @default("member")
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  chat_messages    chat_messages[]
  notifications    notifications[]
  registrations    registrations[]
  sessions         sessions[]
  support_requests support_requests[]
}
