DATABASE_URL=postgresql://comunia:CHANGE_ME@127.0.0.1:55432/comunia
PORT=3001
PG_DATA_DIR=E:/ComunIA/postgres-data
PG_BIN=C:/Program Files/PostgreSQL/16/bin
# Na Vercel, use a URL PostgreSQL da integração Neon (com TLS e pool).
# APP_ORIGINS=https://seu-dominio.com.br
# DATABASE_URL_UNPOOLED=postgresql://usuario:senha@host-direto/banco?sslmode=verify-full
# Prisma Migrate usa a conexão direta acima, quando definida. A API usa DATABASE_URL.
